====================== Shell Monitor Script-================

#!/bin/bash

while true
do
   echo "==============="
   echo "Pathnex Monitoring"
   echo "====================="


   echo "1) IP"
   echo "2) Disk"
   echo "3) Memory"
   echo "4) Exit"

   read -p "Enter Your Choice" choice

   case $choice in
       
       1) 
          echo "IP Address:"
	  hostname -I
	  ;;

        2)
	  echo "Disk usage:"
	  df -h
	  ;;
	 3) 
	   echo "Memory Usage"
	    free -h
	    ;;
	 4)

	   echo "Exiting..."
	   exit 0
	   ;;

	 *) 
	    echo "Invalid Choice"
	    ;;

    esac

    echo

 done

 ====================== Jenkins Pipeline =================


 pipeline{
      agent any 

      environment{
             INSTITUTE_NAME = "Pathnex"
	     TEAM         = "Devops"
	     ENV          = "Prod"
	     Project      = "Pathnex-Training"

      }

      stages{
          
	  stage('Infrastructure'){
              
	      echo "Creating infrstructure........"

	      dir('terraform'){
                  sh '''

		      terraform init
		      terraform plan
		      terraform apply - auto-approve
		  '''

	      }
	  }


	  stage('App Deployment'){

              steps{
                
		echo "Deploying Application..."

		dir('ansible'){
                  
		  sh '''
		      ansible-playbook \
		      -i inventory \
		      user-setup.yml

		    '''
                     
		}

		dir('Kubernetes'){
                    
		    sh 
		    '''
		         kubectl apply -f deployment.yml
			 kubectl apply -f service.yml

			 kubectl get deployments
			 kubectl get pods
			 kubectl get services
	            '''		 
		}
	      }
	  }

	  stage('Monitoring Checks'){
            
	        steps{
                    
		    echo " Running monitoring Checks ..."

		    sh '''
		       chmod +x scripts/monitor.sh

		       echo "Ip ADDRESS"

		       hostname -I

		       echo " DISK USAGE"
		       df -h

		       echo " MEMORY USAGE"
		       free -h

		   '''    
		}
	  }

      }

      post{

           success{

              echo "Pipeline completed Successfully."
	   }

           failure{
              echo "Pipeline failed"
	   }
      }

 }



