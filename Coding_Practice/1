

=====================Ansible /User-setup.yml=====================

---
- name: Create Pathnex Admin User
  hosts: all
  become: yes

  vars:
    username: pathnex-admin
    ssh_public_key: "ssh-rsa AAXXXXXXXXXXXXXXXXXX"


    tasks:

     - name: Create User
       ansible.builtin.user:
          name: "{{ username }}"
	  shell: /bin/bash
	  create_home: yes
	  state:present


     - name: Create .ssh directory
       ansible.builtin.file:
           path: "/home/{{username}}/.ssh"
	   state: directory
	   owner:"{{ username}}"
	   group:"{{ username }}"
	   mode: "0700"

      - name: Add SSH public key 

        ansible.builtin.authorized_key:
	   user: "{{ username}}"
	    key: "{{ ssh_public_key }}"
        state: present

    - name: Set shell to bash
      ansible.builtin.user:
        name: "{{ username }}"
        shell: /bin/bash

